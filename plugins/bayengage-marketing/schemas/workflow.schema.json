{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://targetbay.com/schemas/bayengage-marketing/workflow.schema.json",
  "title": "Marketing workflow plan",
  "description": "A planned automation or campaign sequence, expressed as one or more variants over a shared objective. Topology is deliberately unconstrained in size: there is no maximum node count and no maximum variant count, because the correct shape is a business decision, not a schema default.",
  "type": "object",
  "required": ["objective", "variants"],
  "additionalProperties": false,
  "properties": {
    "objective": {
      "description": "The business outcome this workflow exists to produce.",
      "type": "string",
      "minLength": 1
    },
    "produced_by": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "workflow_type": {
      "type": "string",
      "enum": ["automation", "campaign_sequence", "drip", "one_off_campaign"]
    },
    "variants": {
      "description": "One entry per distinct journey. A single variant is a valid and often correct answer.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/variant" }
    },
    "rejected_variants": {
      "description": "Variants that were considered and deliberately not created. Recording these prevents the same split being re-proposed every run.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "estimated_audience_size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "required": ["name", "audience", "rationale", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "audience": {
          "description": "Who enters this variant, in business terms. Must be resolvable against bayengage.segmentation before execution.",
          "type": "string",
          "minLength": 1
        },
        "estimated_audience_size": { "type": "integer", "minimum": 0 },
        "rationale": {
          "description": "Why this audience warrants its own journey rather than a branch inside another variant.",
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["email", "sms"] }
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        },
        "exit_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "success_metric": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "purpose"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": {
          "type": "string",
          "enum": [
            "trigger",
            "wait",
            "condition",
            "branch",
            "email",
            "sms",
            "audience_check",
            "purchase_check",
            "engagement_check",
            "product_condition",
            "price_condition",
            "attribute_condition",
            "goal",
            "exit"
          ]
        },
        "purpose": {
          "description": "Why this node exists. A node that cannot justify itself should be removed.",
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "description": "When this node fires relative to the previous node, e.g. 'P2D' or 'next weekday 10:00 local'.",
          "type": "string"
        },
        "content_direction": { "type": "string" },
        "parameters": {
          "description": "Free-form node configuration. Deliberately untyped: the authoritative parameter shape belongs to the BayEngage MCP, not to this package.",
          "type": "object"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "condition": {
          "description": "Branch label, e.g. 'purchased' / 'did not purchase'. Required on edges leaving a branch or condition node.",
          "type": "string"
        }
      }
    }
  }
}
